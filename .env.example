# Copy to .env for local Docker Compose use. These values are for local development only.
DATABASE_URL=postgresql+psycopg://incubrix:local-dev-only@postgres:5432/incubrix
POSTGRES_DB=incubrix
POSTGRES_USER=incubrix
POSTGRES_PASSWORD=local-dev-only
MINIO_ENDPOINT=http://storage:9090
MINIO_ACCESS_KEY=incubrix-local
MINIO_SECRET_KEY=local-minio-secret
MINIO_BUCKET=incubrix-artifacts
LOG_LEVEL=INFO
SIMULATION_MODE=true
DEFAULT_RATE_LIMIT_REQUESTS=60
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
APP_CONFIG_FILE=
CALLBACK_HMAC_SECRET=replace-for-local-use
ECHO_SLEEP_SECONDS=3
